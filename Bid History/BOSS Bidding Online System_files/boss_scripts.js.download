/* ---------------------------------------------
COLLAPSIBLE
------------------------------------------------ */
jQuery.noConflict()(function($){
		
  $("html").addClass("add_collapsible");
  // override the following default plugin settings to have everything expanded by default:
  //$.fn.expandAll.defaults.state = "shown";
  //$.fn.expandAll.defaults.initTxt = "hide";

	  $("#boss_collapsible_LeftPanel div.cat h3.expand").toggler();
	  $("#boss_collapsible_RightPanel div.cat h3.expand").toggler();  
	  // $("#boss_collapsible_XXX div.cat h3.expand").toggler(); // declare new ID if you want create another div
  
	  $("#rightPanel").expandAll({trigger: "h3.expand", ref: "h3.expand"});
	  $("#leftPanel").expandAll({trigger: "h3.expand", ref: "h3.expand"});
  
   $("#boss_collapsibleWrap div.post").expandAll({
	});
	$("html").removeClass("add_collapsible");
  });

function AlertThenRedirect(sMsg, sURL) {
    alert(unescape(sMsg));
    window.location = decodeURI(sURL);
}

function Alert(sMsg, sURL) {
    alert(unescape(sMsg));
}

  
  
  
  
  
  

